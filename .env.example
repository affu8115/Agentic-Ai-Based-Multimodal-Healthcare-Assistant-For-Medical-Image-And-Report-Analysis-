# Environment Configuration for Healthcare Multimodal Assistant

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-super-secret-key-in-production-random32bytes
JWT_SECRET_KEY=change-this-jwt-secret-key-for-session-tokens-987654321

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///healthcare.db

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16

# AI API Key (Optional for live multimodal calls; system includes intelligent clinical fallback if empty)
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# OCR Configuration (Path to tesseract binary if not on system PATH in Windows)
# e.g., C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

